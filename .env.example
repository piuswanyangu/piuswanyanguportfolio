# Public origin used for canonical URLs, Open Graph metadata, sitemap.xml,
# and robots.txt.
#
# REQUIRED for `npm run build`. The value is inlined at build time and every
# route is prerendered, so it must be set BEFORE the production build runs -
# setting it afterwards has no effect without rebuilding.
#
# Must be an absolute https:// origin with no trailing path or slash.
# A production build fails if this is missing, not https, or a localhost origin.
#
# `npm run dev` does not require it and falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
